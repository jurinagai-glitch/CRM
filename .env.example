DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
JWT_SECRET=<random-secret-string>
# Only set this once deployed behind a known reverse proxy, to the number of
# proxy hops in front of the app (usually 1). Leave unset for local/direct
# connections. See server/apiApp.ts for why this matters for login rate limiting.
TRUST_PROXY_HOPS=
# Optional. With a key set, pasted meeting notes are read by Claude and the
# 課題/予算/決裁/時期 + next actions are filled in regardless of how the note is
# written. Without it the app falls back to the rule-based extractor, which only
# recognizes the "課題:"/"### 課題"/"➡"/"- [ ]" notations.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-haiku-4-5.
EXTRACTION_MODEL=
