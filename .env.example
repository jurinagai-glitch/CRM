DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
JWT_SECRET=<random-secret-string>
# Only set this once deployed behind a known reverse proxy, to the number of
# proxy hops in front of the app (usually 1). Leave unset for local/direct
# connections. See server/apiApp.ts for why this matters for login rate limiting.
TRUST_PROXY_HOPS=
# --- 議事録のAI抽出（任意・無料で使えます） ---
# キーを設定すると、貼り付けた議事録をAIが読んで 課題/予算/決裁/時期 と次アクションを
# 書式に関係なく埋めます。未設定なら従来のルールベース抽出にフォールバックするため、
# キーなしでもアプリはそのまま動きます（「課題:」「### 課題」「➡」「- [ ]」の記法のみ認識）。
#
# 推奨: Groq の無料枠（支払い方法の登録不要・1日1,000リクエストまで無料）
#   1. https://console.groq.com/keys でキーを発行し、下に貼る
#   2. https://console.groq.com/settings/data-controls で Zero Data Retention を有効化
#      （Groqは規約で入力を学習に使わないと明記していますが、保持もさせない設定です）
EXTRACTION_API_KEY=
# 既定は Groq。OpenAI互換エンドポイントなら差し替え可能
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   ローカルOllama: http://localhost:11434/v1  （その場合キーは不要）
EXTRACTION_BASE_URL=
# 既定は qwen/qwen3.8-27b（Groq無料枠で日本語が最も安定・厳密なJSON出力に対応）
# 代替: openai/gpt-oss-120b
# 注意: preview/Beta表記のモデルはGroqのデータ保護契約の対象外なので顧客データには使わないこと
EXTRACTION_MODEL=
